---
whiskers:
  version: "^2.5"
  matrix:
    - flavor
  filename: "themes/catppuccin-{{flavor.identifier}}.json"
---
{
    "name": "my-dashboard catppuccin",
    "author": "noosxe",
    "url": "https://github.com/noosxe/my-dashboard",
    "themes": [
        {
                "name": "Catppuccin {{flavor.name}}",
                "mode": "{% if flavor.dark %}dark{% else %}light{% endif %}",
                "colors": {
                "accent.background": "#{{surface0.hex}}",
                "accent.foreground": "#{{text.hex}}",
                "accordion.background": "#{{mantle.hex}}",
                "background": "#{{base.hex}}",
                "border": "#{{surface0.hex}}",
                "caret": "#{{text.hex}}",
                "chart_1": "#{{sapphire.hex}}",
                "chart_2": "#{{blue.hex}}",
                "chart_3": "#{{mauve.hex}}",
                "chart_4": "#{{green.hex}}",
                "chart_5": "#{{yellow.hex}}",
                "chart_bullish": "#{{green.hex}}",
                "chart_bearish": "#{{red.hex}}",
                "danger.background": "#{{red.hex}}",
                "danger.foreground": "#{{crust.hex}}",
                "description_list_label.background": "#{{surface0.hex}}",
                "description_list_label.foreground": "#{{text.hex}}",
                "drag_border": "#{{sapphire.hex}}",
                "drop_target.background": "#{{sapphire.hex}}19",
                "foreground": "#{{text.hex}}",
                "group_box.background": "#{{base.hex}}",
                "group_box.foreground": "#{{text.hex}}",
                "info.background": "#{{sky.hex}}",
                "info.foreground": "#{{crust.hex}}",
                "input.border": "#{{surface0.hex}}",
                "link.foreground": "#{{sapphire.hex}}",
                "link.active.foreground": "#{{sapphire.hex}}",
                "link.hover.foreground": "#{{sky.hex}}",
                "list.background": "#{{mantle.hex}}",
                "list.active.background": "#{{sapphire.hex}}33",
                "list.active.border": "#{{sapphire.hex}}",
                "list.even.background": "#{{base.hex}}66",
                "list.head.background": "#{{mantle.hex}}",
                "list.hover.background": "#{{surface0.hex}}",
                "muted.background": "#{{surface0.hex}}",
                "muted.foreground": "#{{subtext0.hex}}",
                "overlay": "#{{crust.hex}}66",
                "popover.background": "#{{base.hex}}",
                "popover.foreground": "#{{text.hex}}",
                "primary.background": "#{{sapphire.hex}}",
                "primary.active.background": "#{{sky.hex}}",
                "primary.foreground": "#{{crust.hex}}",
                "primary.hover.background": "#{{sky.hex}}",
                "progress_bar.background": "#{{sapphire.hex}}",
                "ring": "#{{sapphire.hex}}",
                "scrollbar.background": "#{{mantle.hex}}00",
                "scrollbar.thumb.background": "#{{overlay0.hex}}e6",
                "scrollbar.thumb.hover.background": "#{{overlay2.hex}}",
                "secondary.background": "#{{surface0.hex}}",
                "secondary.active.background": "#{{surface1.hex}}",
                "secondary.foreground": "#{{text.hex}}",
                "secondary.hover.background": "#{{surface1.hex}}",
                "selection.background": "#{{sapphire.hex}}",
                "sidebar.background": "#{{mantle.hex}}",
                "sidebar.accent.background": "#{{surface0.hex}}",
                "sidebar.accent.foreground": "#{{text.hex}}",
                "sidebar.border": "#{{surface0.hex}}",
                "sidebar.foreground": "#{{text.hex}}",
                "sidebar.primary.background": "#{{sapphire.hex}}",
                "sidebar.primary.foreground": "#{{crust.hex}}",
                "skeleton.background": "#{{surface0.hex}}",
                "slider.bar.background": "#{{surface1.hex}}",
                "slider.thumb.background": "#{{text.hex}}",
                "success.background": "#{{green.hex}}",
                "success.foreground": "#{{crust.hex}}",
                "switch.background": "#{{surface1.hex}}",
                "tab.background": "#00000000",
                "tab.active.background": "#{{base.hex}}",
                "tab.active.foreground": "#{{text.hex}}",
                "tab.foreground": "#{{subtext0.hex}}",
                "tab_bar.background": "#{{mantle.hex}}",
                "tab_bar.segmented.background": "#{{mantle.hex}}",
                "table.background": "#{{mantle.hex}}",
                "table.active.background": "#{{sapphire.hex}}33",
                "table.active.border": "#{{sapphire.hex}}",
                "table.even.background": "#{{base.hex}}66",
                "table.head.background": "#{{mantle.hex}}",
                "table.head.foreground": "#{{overlay1.hex}}",
                "table.hover.background": "#{{surface0.hex}}",
                "table.row.border": "#{{surface0.hex}}b3",
                "tiles.background": "#{{mantle.hex}}",
                "title_bar.background": "#{{mantle.hex}}",
                "title_bar.border": "#{{surface0.hex}}",
                "status_bar.background": "#{{mantle.hex}}",
                "status_bar.border": "#{{surface0.hex}}",
                "warning.background": "#{{yellow.hex}}",
                "warning.foreground": "#{{crust.hex}}",
                "window.border": "#{{surface0.hex}}",
                "base.red": "#{{red.hex}}",
                "base.red.light": "#{{maroon.hex}}",
                "base.green": "#{{green.hex}}",
                "base.green.light": "#{{teal.hex}}",
                "base.blue": "#{{blue.hex}}",
                "base.blue.light": "#{{lavender.hex}}",
                "base.yellow": "#{{yellow.hex}}",
                "base.yellow.light": "#{{rosewater.hex}}",
                "base.magenta": "#{{mauve.hex}}",
                "base.magenta.light": "#{{pink.hex}}",
                "base.cyan": "#{{sky.hex}}",
                "base.cyan.light": "#{{teal.hex}}"
            }
        }
    ]
}
